// Mandelbulb ray marcher with perturbation, injected after tonemapping by FFractalSceneViewExtension.
// All fractal maths lives in FractalRender.ush / FractalPerturbation.ush (pure HLSL, also exercised by
// Tools/PerturbationLab); this file only binds Unreal's shader parameters.

#include "/Engine/Public/Platform.ush"

#if FP_STATIC_POWER_8
#define FP_STATIC_INTEGER_POWER 8
#endif

#include "FractalRender.ush"

// Shader parameters (FPerturbationComputeShader::FParameters)
int2 OutputSize;
int2 OutputOffset;
float3 RayDir00;
float PixelRadiusPerUnitDistance;
float3 RayDirDX;
float FractalScale;
float3 RayDirDY;
float FractalPower;
float3 CameraOffset;
float BailoutRadius;
float3 ReferenceCenter;
float DirectFootprint;
int OrbitLength;
int MaxRaySteps;
int MaxIterations;
int MinIterations;
float MaxRayDistance;
float ConvergenceFactor;
float2 BackgroundInvExtent;
Texture2D<float4> BackgroundTexture;
SamplerState BackgroundSampler;
StructuredBuffer<float4> ReferenceOrbit;
RWTexture2D<float4> OutputTexture;

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void PerturbationShader(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (DispatchThreadId.x >= (uint)OutputSize.x || DispatchThreadId.y >= (uint)OutputSize.y)
	{
		return;
	}

	FPViewParams V;
	V.RayDir00 = RayDir00;
	V.RayDirDX = RayDirDX;
	V.RayDirDY = RayDirDY;
	V.PixelRadiusPerUnitDistance = PixelRadiusPerUnitDistance;
	V.CameraOffset = CameraOffset;
	V.Scale = FractalScale;
	V.ReferenceCenter = ReferenceCenter;
	V.Power = FractalPower;
	V.Bailout = BailoutRadius;
	V.MaxIterations = MaxIterations;
	V.MinIterations = MinIterations;
	V.ConvergenceFactor = ConvergenceFactor;
	V.MaxRaySteps = MaxRaySteps;
	V.MaxRayDistance = MaxRayDistance;
	V.OrbitLength = OrbitLength;
	V.DirectFootprint = DirectFootprint;

	float3 Dir = FP_PixelRayDirection(V, DispatchThreadId.xy);
	FPMarchResult March = FP_MarchRay(ReferenceOrbit, V, Dir);

	// The output texture shares the scene colour extent; write inside the view rect.
	uint2 PixelPos = DispatchThreadId.xy + (uint2)OutputOffset;
	float2 BackgroundUV = saturate((float2(PixelPos) + 0.5f) * BackgroundInvExtent);
	float3 Background = BackgroundTexture.SampleLevel(BackgroundSampler, BackgroundUV, 0.0f).rgb;
	OutputTexture[PixelPos] = float4(FP_CompositeMarch(March, Background, MaxRaySteps, MaxIterations), 1.0f);
}
