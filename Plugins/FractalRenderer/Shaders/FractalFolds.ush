// Exact perturbation of the box and sphere folds (CPU: FractalMath/Formulas/FoldMaths.h). Pure HLSL.
//
// The folds are continuous and piecewise smooth. A pixel (Z + d) can be in a different branch than the
// reference Z; the folded difference is then written with the reference's distance to the branch boundary,
// which the CPU rounds from double-double, so no catastrophic cancellation occurs in any branch combination.

#pragma once

#include "FractalMathCommon.ush"

// Box fold (limit 1) of one component: x -> 2 - x (x > 1), -2 - x (x < -1), x otherwise.
// Z is the float reference, U = 1 - Z and L = 1 + Z are precise, D is the pixel offset. Returns
// fold(Z + D) - fold(Z) and the folded reference in OutB.
float FP_PerturbedBoxFold(float Z, float U, float L, float D, out float OutB)
{
	int Ref = (U < 0.0f) ? 1 : ((L < 0.0f) ? -1 : 0);
	int Pix = (D > U) ? 1 : ((D < -L) ? -1 : 0);
	OutB = (Ref == 1) ? 2.0f - Z : ((Ref == -1) ? -2.0f - Z : Z);
	if (Ref == Pix)
	{
		return (Ref == 0) ? D : -D;
	}
	if (Ref == 0)
	{
		return (Pix == 1) ? 2.0f * U - D : -2.0f * L - D;   // (2 - Z - D) - Z,  (-2 - Z - D) - Z
	}
	if (Pix == 0)
	{
		return (Ref == 1) ? D - 2.0f * U : D + 2.0f * L;    // (Z + D) - (2 - Z),  (Z + D) - (-2 - Z)
	}
	return (Ref == 1) ? -4.0f - D : 4.0f - D;               // opposite planes
}

// Sphere fold (r_min^2 = 1/4, r_fixed^2 = 1): z -> k z with k = 4, 1 / |z|^2 or 1.
// B is the float reference entering the fold, Delta the pixel offset (replaced by the folded offset),
// SF = (1/4 - |B|^2, 1 - |B|^2, |B|^2) from FractalMath::Folds::PackSphereFold. Returns the pixel's k.
// The folded offset is k_p Delta + (k_p - k_r) B, with k_p - k_r written without cancellation:
//   both inversion:   -(r_p^2 - r^2) / (r_p^2 r^2)
//   inner -> inversion: 4 (1/4 - r_p^2) / r_p^2,   inversion -> inner: -4 (1/4 - r^2) / r^2
//   inversion -> outer: -(1 - r^2) / r^2,          outer -> inversion: (1 - r_p^2) / r_p^2
float FP_PerturbedSphereFold(float3 B, inout float3 Delta, float3 SF)
{
	float Dm = SF.x;
	float DF = SF.y;
	float R2 = SF.z;
	float DR2 = 2.0f * dot(B, Delta) + dot(Delta, Delta); // r_p^2 - r^2
	int Ref = (Dm > 0.0f) ? 0 : ((DF > 0.0f) ? 1 : 2);   // 0 inner, 1 inversion, 2 outer
	int Pix = (DR2 < Dm) ? 0 : ((DR2 < DF) ? 1 : 2);
	float RP2 = R2 + DR2;
	float KP = (Pix == 0) ? 4.0f : ((Pix == 1) ? 1.0f / RP2 : 1.0f);
	float DK;
	if (Ref == Pix)
	{
		DK = (Ref == 1) ? -DR2 / (RP2 * R2) : 0.0f;
	}
	else if (Ref == 0)
	{
		DK = (Pix == 1) ? 4.0f * (Dm - DR2) / RP2 : -3.0f;
	}
	else if (Ref == 1)
	{
		DK = (Pix == 0) ? -4.0f * Dm / R2 : -DF / R2;
	}
	else
	{
		DK = (Pix == 1) ? (DF - DR2) / RP2 : 3.0f;
	}
	Delta = KP * Delta + DK * B;
	return KP;
}

// Plain float sphere fold factor for |z|^2 = R2.
float FP_SphereFoldFactor(float R2)
{
	return (R2 < 0.25f) ? 4.0f : ((R2 < 1.0f) ? 1.0f / R2 : 1.0f);
}
