// Per-pixel fractal ray march on top of FractalDE.ush. Pure HLSL, shared by
// PerturbationShader.usf (Unreal) and Tools/PerturbationLab (DXC + Vulkan).
//
// Coordinates: the ray is marched in WORLD units (t), the fractal is sampled at
//     c = C_ref + Scale * (CameraOffset + t * Dir)
// i.e. dc = Scale * (CameraOffset + t * Dir) relative to the reference point. CameraOffset is
// (camera - C_ref) / Scale, computed on the CPU in double-double, so no absolute fractal coordinate
// ever reaches the GPU and float precision is only needed relative to the visible scale.

#pragma once

#include "FractalDE.ush"

// Set to 1 to march with plain float DE at absolute positions (comparison / debugging only).
#ifndef FP_FORCE_NAIVE
#define FP_FORCE_NAIVE 0
#endif

#define FP_HIT_NONE 0
#define FP_HIT_SURFACE 1
#define FP_MISS_DISTANCE 2
#define FP_MISS_STEPS 3

struct FPViewParams
{
	float3 RayDir00;      // world direction through pixel (0, 0) (unnormalised)
	float3 RayDirDX;      // per-pixel step to the right
	float3 RayDirDY;      // per-pixel step down
	float2 PixelStep;     // full-resolution pixels per marched pixel (1 = full resolution, 2 = half resolution)
	float PixelRadiusPerUnitDistance; // of one full-resolution pixel (the hit threshold; independent of the render scale)
	float3 CameraOffset;  // (camera - C_ref) / Scale, world units
	float Scale;          // fractal units per world unit
	float3 ReferenceCenter; // float(C_ref), only used without a reference orbit
	float Power;          // exponent or folding scale
	float Bailout;
	int MaxIterations;
	int HazeBase;         // iterations the camera's own orbit needs: the haze measures the share of the iterations beyond it
	int MaxRaySteps;
	float MaxRayDistance; // world units
	int OrbitLength;
	float DirectFootprint; // fractal units; samples whose pixel footprint exceeds this use the cheaper plain
	                       // float DE (exact enough there). 0 = always perturb.
};

struct FPMarchResult
{
	float Distance;       // world units along the (normalised) ray
	int Steps;
	int Status;
	int TotalIterations;  // sum of escape iterations over the march
	int TotalSkipped;     // iterations the series skip did not have to execute
	int LastIterations;   // iterations of the last distance estimate
	float LastSmooth;     // its continuous escape iteration (the colour of a hit)
	bool bLastEscaped;    // the last distance estimate saw its orbit escape (false: it ran into the iteration limit)
	float3 LastGradient;  // its gradient direction (the analytic surface normal of a hit; 0 if the formula has none)
};

// Direction through marched pixel coordinates Pixel (pixel centres are integers). The ray basis is expressed in
// full-resolution pixels (its origin is the centre of pixel 0), so a marched pixel covers PixelStep of them.
float3 FP_PixelRayDirectionAt(FPViewParams V, float2 Pixel)
{
	float2 Full = (Pixel + 0.5f) * V.PixelStep - 0.5f;
	return normalize(V.RayDir00 + Full.x * V.RayDirDX + Full.y * V.RayDirDY);
}

float3 FP_PixelRayDirection(FPViewParams V, uint2 Pixel)
{
	return FP_PixelRayDirectionAt(V, (float2)Pixel);
}

FPDEResult FP_DistanceEstimate(StructuredBuffer<float4> Orbit, FPViewParams V, FPFormulaArgs Args, float3 DC, float PixelRadius)
{
	FPDEResult DE;
#if FP_FORCE_NAIVE
	DE = FP_DirectDE(V.ReferenceCenter + DC, Args, V.MaxIterations, V.Bailout);
#else
	// Plain float evaluation when there is no reference orbit yet, or when this sample's pixel footprint is
	// so large that absolute float coordinates resolve it (the hybrid switch; cheaper per iteration).
	if (V.OrbitLength < 2 || (V.DirectFootprint > 0.0f && V.Scale * PixelRadius > V.DirectFootprint))
	{
		DE = FP_DirectDE(V.ReferenceCenter + DC, Args, V.MaxIterations, V.Bailout);
	}
	else
	{
		DE = FP_PerturbedDE(Orbit, V.OrbitLength, DC, Args, V.MaxIterations, V.Bailout);
	}
#endif
	return DE;
}

// Over-relaxed sphere tracing (Keinert et al. 2014): steps of FP_RELAX times the distance while consecutive spheres overlap,
// back inside the previous sphere and plain steps from the first miss. Fewer steps where rays run along a surface.
#ifndef FP_RELAX
#define FP_RELAX 1.6f
#endif

// Marches Dir from the camera, starting at TStart (world units; nothing is hit before it, see FP_ConeMarch). A negative
// TStart means the ray hits nothing.
FPMarchResult FP_MarchRayFrom(StructuredBuffer<float4> Orbit, FPViewParams V, float3 Dir, float TStart)
{
	FPMarchResult Result;
	Result.Distance = 0.0f;
	Result.Steps = 0;
	Result.Status = FP_MISS_STEPS;
	Result.TotalIterations = 0;
	Result.TotalSkipped = 0;
	Result.LastIterations = 0;
	Result.LastSmooth = 0.0f;
	Result.bLastEscaped = false;
	Result.LastGradient = 0.0f;

	FPFormulaArgs Args = FP_MakeFormulaArgs(V.Power, V.Scale);
	float T = 0.0f;
	float TEnd = V.MaxRayDistance;
#if FP_HAS_BOUND
	// Bounding sphere of the set: a ray that misses it hits nothing (background, no marching), and one that
	// crosses it is marched from where it enters. The escape-time estimate overshoots far from the set, so without
	// this a ray could step clean over the object (and rays grazing the sphere would crawl).
	{
		float R = FP_FormulaBoundingRadius(V.Power) * 1.001f;
		float3 O = V.ReferenceCenter + V.Scale * V.CameraOffset; // absolute position; only used outside the sphere
		float C = dot(O, O) - R * R;
		if (C > 0.0f)
		{
			float B = dot(O, Dir);
			float Disc = B * B - C;
			if (B >= 0.0f || Disc < 0.0f)
			{
				Result.Status = FP_MISS_DISTANCE;
				return Result;
			}
			float Root = sqrt(Disc);
			T = (-B - Root) / V.Scale;
			TEnd = min(TEnd, (-B + Root) / V.Scale);
		}
	}
#endif
	if (TStart < 0.0f || TStart >= TEnd)
	{
		Result.Status = FP_MISS_DISTANCE;
		Result.Distance = TEnd;
		return Result;
	}
	T = max(T, TStart);
	float Omega = FP_RELAX;
	float PrevRadius = 0.0f;
	float StepLength = 0.0f;
	[loop]
	while (Result.Steps < V.MaxRaySteps)
	{
		if (T >= TEnd)
		{
			Result.Status = FP_MISS_DISTANCE;
			break;
		}
		Result.Steps++;
		float3 DC = V.Scale * (V.CameraOffset + Dir * T);
		float PixelRadius = T * V.PixelRadiusPerUnitDistance;
		FPDEResult DE = FP_DistanceEstimate(Orbit, V, Args, DC, PixelRadius);
		Result.TotalIterations += DE.Iterations;
		Result.TotalSkipped += DE.Skipped;
		float Radius = DE.Distance;
		if (Omega > 1.0f && Radius + PrevRadius < StepLength)
		{
			// the relaxed step left the previous sphere: go back inside it and continue with plain steps
			StepLength -= Omega * StepLength;
			Omega = 1.0f;
		}
		else
		{
			Result.LastIterations = DE.Iterations;
			Result.LastSmooth = DE.Smooth;
			Result.bLastEscaped = DE.bEscaped;
			Result.LastGradient = DE.Gradient;
			if (Radius <= PixelRadius)
			{
				Result.Status = FP_HIT_SURFACE;
				break;
			}
			StepLength = max(Radius, PixelRadius * 0.5f) * Omega;
		}
		PrevRadius = Radius;
		T += StepLength;
	}
	Result.Distance = T;
	return Result;
}

FPMarchResult FP_MarchRay(StructuredBuffer<float4> Orbit, FPViewParams V, float3 Dir)
{
	return FP_MarchRayFrom(Orbit, V, Dir, 0.0f);
}

// Cone pre-pass: the ray through the centre of a tile of marched pixels, widened to a cone of half-angle C (per unit
// distance) that contains all their rays. A pixel's ray is within T C of the cone axis at distance T, so while the
// distance estimate D at the axis exceeds T C, a step of (D - T C) / (1 + C) keeps every one of them inside the empty
// sphere. Returns the distance (world units) all of them can start from, or -1 when the cone leaves the scene without
// meeting anything. The estimate is only trusted to FP_CONE_SAFETY of its value: it can overestimate the distance to
// thin geometry (strands, dust) by a small factor, which a pixel's own march absorbs near the surface but which would
// let a whole tile start behind such a strand.
#ifndef FP_CONE_SAFETY
#define FP_CONE_SAFETY 0.7f
#endif
float FP_ConeMarch(StructuredBuffer<float4> Orbit, FPViewParams V, float3 Dir, float C)
{
	FPFormulaArgs Args = FP_MakeFormulaArgs(V.Power, V.Scale);
	float T = 0.0f;
	float TEnd = V.MaxRayDistance;
#if FP_HAS_BOUND
	{
		float3 O = V.ReferenceCenter + V.Scale * V.CameraOffset;
		// the bounding sphere grown by the cone's width where it can reach it
		float R = FP_FormulaBoundingRadius(V.Power) * 1.001f + C * (length(O) + FP_FormulaBoundingRadius(V.Power));
		float CC = dot(O, O) - R * R;
		if (CC > 0.0f)
		{
			float B = dot(O, Dir);
			float Disc = B * B - CC;
			if (B >= 0.0f || Disc < 0.0f)
			{
				return -1.0f;
			}
			float Root = sqrt(Disc);
			T = (-B - Root) / V.Scale;
			TEnd = min(TEnd, (-B + Root) / V.Scale);
		}
	}
#endif
	[loop]
	for (int Step = 0; Step < V.MaxRaySteps; ++Step)
	{
		if (T >= TEnd)
		{
			return -1.0f;
		}
		float3 DC = V.Scale * (V.CameraOffset + Dir * T);
		float D = FP_CONE_SAFETY * FP_DistanceEstimate(Orbit, V, Args, DC, T * C).Distance;
		if (D < 2.0f * T * C || D <= 0.0f)
		{
			break;
		}
		T += (D - T * C) / (1.0f + C);
	}
	return T;
}

// Half-angle (per unit distance) of the cone around the centre ray of a Tile x Tile block of marched pixels.
float FP_ConeAngle(FPViewParams V, int Tile)
{
	float Half = 0.5f * (float)Tile + 0.5f;
	float HX = Half * length(V.RayDirDX) * V.PixelStep.x;
	float HY = Half * length(V.RayDirDY) * V.PixelStep.y;
	return sqrt(HX * HX + HY * HY) * 1.05f;
}

// ---------------------------------------------------------------------------------------------
// Shading
// ---------------------------------------------------------------------------------------------
// Surfaces are lit (headlight + one fixed light) with the normal taken from the distance estimate's gradient.
// The number of march steps only darkens (ambient occlusion: rays that crawl along crevices); it never brightens.
// The colour comes from the iteration at which the hit point escapes.
//
// The iteration limit is the limit of the detail the renderer can resolve. Where it is approached the surface fades
// into haze instead of ending in a hard edge: a hit whose orbit needed a large share of the limit (smooth escape
// iteration over the limit, from FP_HazeStart on) blends towards the haze colour, and one that never escaped
// (the orbit ran into the limit) is fully hazed. Rays that never hit show the background, with a faint glow where
// they grazed geometry.

float3 FP_Palette(float T)
{
	// Cosine palette (Inigo Quilez): deep blue -> teal -> violet as the escape iteration grows.
	return float3(0.42f, 0.52f, 0.66f) + float3(0.30f, 0.28f, 0.26f) * cos(6.2831853f * (T + float3(0.00f, 0.12f, 0.30f)));
}

// Gradient of the distance estimate at the hit point (tetrahedron taps, world units).
float3 FP_SurfaceNormal(StructuredBuffer<float4> Orbit, FPViewParams V, FPFormulaArgs Args, float3 Dir, float T, float PixelRadius)
{
	float Eps = max(PixelRadius, 1.0e-6f * max(T, 1.0f));
	float3 DCHit = V.Scale * (V.CameraOffset + Dir * T);
	const float3 K0 = float3(1.0f, -1.0f, -1.0f);
	const float3 K1 = float3(-1.0f, -1.0f, 1.0f);
	const float3 K2 = float3(-1.0f, 1.0f, -1.0f);
	const float3 K3 = float3(1.0f, 1.0f, 1.0f);
	float3 G = K0 * FP_DistanceEstimate(Orbit, V, Args, DCHit + V.Scale * Eps * K0, PixelRadius).Distance
		+ K1 * FP_DistanceEstimate(Orbit, V, Args, DCHit + V.Scale * Eps * K1, PixelRadius).Distance
		+ K2 * FP_DistanceEstimate(Orbit, V, Args, DCHit + V.Scale * Eps * K2, PixelRadius).Distance
		+ K3 * FP_DistanceEstimate(Orbit, V, Args, DCHit + V.Scale * Eps * K3, PixelRadius).Distance;
	float L2 = dot(G, G);
	return (L2 > 0.0f) ? G * rsqrt(L2) : -Dir;
}

// Share of the iteration limit at which a hit starts to fade into haze (fully hazed at the limit).
#ifndef FP_HAZE_START
#define FP_HAZE_START 0.55f
#endif

float3 FP_HazeColor(float3 Background)
{
	return lerp(Background, float3(0.50f, 0.64f, 0.86f), 0.6f);
}

float3 FP_Shade(StructuredBuffer<float4> Orbit, FPViewParams V, FPMarchResult R, float3 Dir, float3 Background)
{
	float StepFactor = saturate(R.Steps / max((float)V.MaxRaySteps, 1.0f));
	if (R.Status == FP_MISS_DISTANCE)
	{
		// Faint cool glow around geometry the ray crawled past; the sky otherwise.
		return lerp(Background, float3(0.35f, 0.55f, 0.85f), 0.25f * StepFactor * StepFactor);
	}

	FPFormulaArgs Args = FP_MakeFormulaArgs(V.Power, V.Scale);
	float PixelRadius = R.Distance * V.PixelRadiusPerUnitDistance;
	// Formulas with a Jacobian derivative give the normal for free (grad |z| at the hit, the gradient of the
	// distance estimate up to a factor); the others take 4 more distance estimates.
	float G2 = dot(R.LastGradient, R.LastGradient);
	float3 N = (G2 > 0.0f) ? R.LastGradient * rsqrt(G2) : FP_SurfaceNormal(Orbit, V, Args, Dir, R.Distance, PixelRadius);
	N = (dot(N, Dir) > 0.0f) ? -N : N; // face the viewer

	float Headlight = saturate(dot(N, -Dir));
	float Key = saturate(dot(N, normalize(float3(0.5f, 0.7f, 0.4f))));
	float Light = 0.12f + 0.5f * Headlight + 0.3f * Key;

	// Steps darken (crevices); a ray that ran out of steps next to the surface is darker still.
	float AO = 1.0f - 0.7f * sqrt(StepFactor);
	if (R.Status == FP_MISS_STEPS)
	{
		AO *= 0.6f;
	}

	float3 Albedo = FP_Palette(log2(1.0f + R.LastSmooth) * 0.22f);
	float3 Color = Albedo * Light * AO;

	// Detail limit: fade towards haze as the orbit uses up the iteration limit (an orbit that never escaped has).
	float Used = R.bLastEscaped ? (R.LastSmooth - (float)V.HazeBase) / max((float)(V.MaxIterations - V.HazeBase), 1.0f) : 1.0f;
	float Haze = smoothstep(FP_HAZE_START, 1.0f, Used);
	Color = lerp(Color, FP_HazeColor(Background), Haze);

	// Distance fog towards the background, in fractal units so it does not depend on the zoom.
	float Fog = 1.0f - exp(-V.Scale * R.Distance * 0.25f);
	return lerp(Color, Background, saturate(Fog));
}
