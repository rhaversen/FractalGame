// Mandelbulb perturbation maths (GPU side). Pure HLSL, no engine includes: used by
// PerturbationShader.usf in Unreal and compiled with DXC by Tools/PerturbationLab for testing.
//
// Every sample point is c = C_ref + dc and its orbit z_n = Z_n + d_n, where the reference orbit Z_n
// was computed on the CPU in double-double precision (MandelbulbReference.h) and dc, d_n are floats.
// The update
//     d_{n+1} = g_p(Z_n + d_n) - g_p(Z_n) + dc
// is evaluated WITHOUT forming g_p(Z_n + d_n) and g_p(Z_n) separately (that would cancel all digits
// once |d| << |Z|). Instead the spherical coordinates of Z+d are expressed relative to Z:
//     dr     = (2 Z.d + d.d) / (|Z+d| + |Z|)
//     drho   = (2 (X dx + Y dy) + dx^2 + dy^2) / (rho_w + rho)
//     dphi   = atan2(X dy - Y dx, X wx + Y wy)                     (exact angle between (X,Y) and (wx,wy))
//     dtheta = atan2(Z drho - rho dz, rho rho_w + Z wz)            (exact angle in the meridian plane)
//     (r/R)^p - 1 = expm1(p log1p(dr / R))
// and the output difference uses sum-to-product identities, e.g.
//     sin(T + dT) - sin(T) = 2 cos(T + dT/2) sin(dT/2).
// All of these are exact identities, so the result is correct for any d (small or large); each term
// only carries float *relative* error. Hardware sin/cos/atan2/log are NOT accurate for tiny arguments
// (D3D only guarantees 8e-4 absolute error for sin/cos), so small-argument functions are implemented
// here with polynomials that keep relative accuracy all the way down to denormals.
//
// Rebasing (Zhuoran): when |z| < |d| the pixel is closer to the critical point than to the reference, so
// we continue with d := z against Z_0 = 0. The same rule is used when the reference orbit runs out.

#pragma once

static const float FP_PI = 3.14159265358979f;
static const float FP_TWO_PI = 6.28318530717959f;
static const float FP_HALF_PI = 1.57079632679490f;
static const float FP_QUARTER_PI = 0.785398163397448f;
static const float FP_TWO_OVER_PI = 0.636619772367581f;

// ---------------------------------------------------------------------------------------------
// Accurate elementary functions (no hardware transcendentals on precision-critical paths)
// ---------------------------------------------------------------------------------------------

// sin/cos with relative accuracy for tiny |x| and ~1e-7 absolute accuracy for |x| up to ~1e4.
// Cody-Waite reduction by pi/2, minimax polynomials on [-pi/4, pi/4] (Cephes sinf/cosf).
void FP_SinCos(float X, out float OutSin, out float OutCos)
{
	float K = round(X * FP_TWO_OVER_PI);
	float R = X - K * 1.5703125f;
	R = R - K * 4.837512969970703125e-4f;
	R = R - K * 7.54978995489188216e-8f;
	float R2 = R * R;
	float SinR = R + R * R2 * (-1.6666654611e-1f + R2 * (8.3321608736e-3f + R2 * -1.9515295891e-4f));
	float CosR = 1.0f - 0.5f * R2 + R2 * R2 * (4.166664568298827e-2f + R2 * (-1.388731625493765e-3f + R2 * 2.443315711809948e-5f));
	int Q = ((int)K) & 3;
	float S = ((Q & 1) != 0) ? CosR : SinR;
	float C = ((Q & 1) != 0) ? SinR : CosR;
	OutSin = ((Q & 2) != 0) ? -S : S;
	OutCos = (((Q + 1) & 2) != 0) ? -C : C;
}

// atan(T) for T in [0, 1]: T * P(T^2), minimax in relative error (1.5e-8 in exact arithmetic,
// ~1.5e-7 evaluated in float). A single polynomial avoids the second division of the usual
// tan(pi/8) range reduction.
float FP_AtanUnit(float T)
{
	float Z = T * T;
	float P = 2.849885728e-03f;
	P = P * Z - 1.606861316e-02f;
	P = P * Z + 4.269149527e-02f;
	P = P * Z - 7.504292578e-02f;
	P = P * Z + 1.064093262e-01f;
	P = P * Z - 1.420364380e-01f;
	P = P * Z + 1.999261975e-01f;
	P = P * Z - 3.333307207e-01f;
	P = P * Z + 1.0f;
	return T * P;
}

// atan2 with relative accuracy for small angles (|Y| << X). atan2(0, 0) = 0.
float FP_Atan2(float Y, float X)
{
	float AX = abs(X);
	float AY = abs(Y);
	bool bSwap = AY > AX;
	float Num = bSwap ? AX : AY;
	float Den = bSwap ? AY : AX;
	float A = FP_AtanUnit(Den > 0.0f ? Num / Den : 0.0f);
	A = bSwap ? FP_HALF_PI - A : A;
	A = (X < 0.0f) ? FP_PI - A : A;
	return (Y < 0.0f) ? -A : A;
}

// log(1 + x) with relative accuracy for small |x|.
float FP_Log1p(float X)
{
	if (abs(X) > 0.5f)
	{
		return log(1.0f + X);
	}
	// 2 atanh(t), t = x / (2 + x), |t| <= 1/3
	float T = X / (2.0f + X);
	float T2 = T * T;
	float P = 0.333333333f + T2 * (0.2f + T2 * (0.142857143f + T2 * (0.111111111f + T2 * (0.0909090909f + T2 * (0.0769230769f + T2 * 0.0666666667f)))));
	return 2.0f * T + 2.0f * T * T2 * P;
}

// exp(x) - 1 with relative accuracy for small |x| (Taylor series up to x^11 on |x| <= 1).
float FP_Expm1(float X)
{
	if (abs(X) > 1.0f)
	{
		return exp(X) - 1.0f;
	}
	return X * (1.0f + X * (0.5f + X * (0.166666667f + X * (0.0416666667f + X * (0.00833333333f + X * (0.00138888889f
		+ X * (1.98412698e-4f + X * (2.48015873e-5f + X * (2.75573192e-6f + X * (2.75573192e-7f + X * 2.50521084e-8f))))))))));
}

// Exact power of two s such that |V| * s is in [1, 2) (V finite, >= 0; returns 2^127 for V == 0).
float FP_Pow2Normalizer(float V)
{
	return asfloat(0x7F000000u - (asuint(V) & 0x7F800000u));
}

// 1 / FP_Pow2Normalizer(V): the power of two with V's exponent (0 for V == 0 or denormal V).
float FP_Pow2Denormalizer(float V)
{
	return asfloat(asuint(V) & 0x7F800000u);
}

// Integer power used for the trig-free paths, 0 for non-integer powers. Defining FP_STATIC_INTEGER_POWER
// (e.g. as a shader permutation for the classic power 8) lets the compiler drop the general path and
// unroll the binary powering loops.
int FP_IntegerPower(float Power)
{
#ifdef FP_STATIC_INTEGER_POWER
	return FP_STATIC_INTEGER_POWER;
#else
	return (Power == floor(Power) && Power >= 2.0f && Power <= 32.0f) ? (int)Power : 0;
#endif
}

// (A + iB)^P for integer P >= 1 by binary powering (absolute accuracy, used for full evaluations).
void FP_ComplexPowInt(float A, float B, int P, out float OutA, out float OutB)
{
	float RA = A;
	float RB = B;
	[loop]
	for (int Bit = firstbithigh(P) - 1; Bit >= 0; --Bit)
	{
		float NA = RA * RA - RB * RB;
		RB = 2.0f * RA * RB;
		RA = NA;
		if (((P >> Bit) & 1) != 0)
		{
			float MA = RA * A - RB * B;
			RB = RA * B + RB * A;
			RA = MA;
		}
	}
	OutA = RA;
	OutB = RB;
}

// A rotation e^{ia} stored as (V, S) = (1 - cos a, sin a). Raising it to the integer power P multiplies
// the angle by P using only additions of non-negative terms (for |P a| < pi), so V and S keep relative
// accuracy for tiny angles -- unlike cos/sin, where cos a - 1 would cancel.
//   double:  S' = 2 S (1 - V),            V' = V (2 - V) + S^2
//   add b:   S' = S cos b + cos a S_b,     V' = V + V_b - V V_b + S S_b
void FP_VersSinPowInt(float V, float S, int P, out float OutV, out float OutS)
{
	float RV = V;
	float RS = S;
	[loop]
	for (int Bit = firstbithigh(P) - 1; Bit >= 0; --Bit)
	{
		float NS = 2.0f * RS * (1.0f - RV);
		RV = RV * (2.0f - RV) + RS * RS;
		RS = NS;
		if (((P >> Bit) & 1) != 0)
		{
			float MS = RS * (1.0f - V) + (1.0f - RV) * S;
			RV = RV + V - RV * V + RS * S;
			RS = MS;
		}
	}
	OutV = RV;
	OutS = RS;
}

// (V, S) of the angle whose cosine and sine are C and S, i.e. V = 1 - C without cancellation.
float FP_VersineFromCosSin(float C, float S)
{
	return (C >= 0.0f) ? S * S / (1.0f + C) : 1.0f - C;
}

// ---------------------------------------------------------------------------------------------
// Reference orbit
// ---------------------------------------------------------------------------------------------

// Mirrors the first three float4 of FractalMath::FOrbitPointGPU (the series-skip data follows, see FP_ORBIT_STRIDE).
struct FPOrbitPoint
{
	float3 Z;     // float-rounded reference Z~_m
	float R;      // |Z~_m|
	float Rho;    // sqrt(X^2 + Y^2)
	float RPow;   // |Z~_m|^p
	float Phi;    // atan2(Y, X), 0 on the polar axis
	float InvR;   // 1 / |Z~_m| (0 for Z~_m = 0)
	float SinPT;  // sin(p theta)
	float CosPT;  // cos(p theta)
	float SinPP;  // sin(p phi)
	float CosPP;  // cos(p phi)
};

FPOrbitPoint FP_DecodeOrbitPoint(float4 A, float4 B, float4 C)
{
	FPOrbitPoint P;
	P.Z = A.xyz;
	P.R = A.w;
	P.Rho = B.x;
	P.RPow = B.y;
	P.Phi = B.z;
	P.InvR = B.w;
	P.SinPT = C.x;
	P.CosPT = C.y;
	P.SinPP = C.z;
	P.CosPP = C.w;
	return P;
}

FPOrbitPoint FP_ZeroOrbitPoint()
{
	FPOrbitPoint P;
	P.Z = float3(0.0f, 0.0f, 0.0f);
	P.R = 0.0f;
	P.Rho = 0.0f;
	P.RPow = 0.0f;
	P.Phi = 0.0f;
	P.InvR = 0.0f;
	P.SinPT = 0.0f;
	P.CosPT = 1.0f;
	P.SinPP = 0.0f;
	P.CosPP = 1.0f;
	return P;
}

// float4s per orbit point (FractalMath::FOrbitPointGPU): 3 for the reference, 3 for the series skip.
#define FP_ORBIT_STRIDE 6

FPOrbitPoint FP_LoadOrbitPoint(StructuredBuffer<float4> Orbit, int Index)
{
	return FP_DecodeOrbitPoint(Orbit[FP_ORBIT_STRIDE * Index], Orbit[FP_ORBIT_STRIDE * Index + 1], Orbit[FP_ORBIT_STRIDE * Index + 2]);
}

// Set to 0 to disable the linear series skip (comparison / debugging).
#ifndef FP_SERIES_SKIP
#define FP_SERIES_SKIP 1
#endif

// ---------------------------------------------------------------------------------------------
// Mandelbulb power map and its perturbation
// ---------------------------------------------------------------------------------------------

// g_p(W) evaluated directly, |W| = RW and 1/|W| = InvRW given. Returns |W|^(p-1) in OutRWPowM1.
// Integer powers use (z + i rho)^p and (x + i y)^p (no transcendental functions), others use trig.
float3 FP_MandelbulbPower(float3 W, float RW, float InvRW, float Power, int PowerInt, out float OutRWPowM1)
{
	if (PowerInt > 0)
	{
		float MaxXY = max(abs(W.x), abs(W.y));
		float XYScale = FP_Pow2Normalizer(MaxXY);
		float SWX = W.x * XYScale;
		float SWY = W.y * XYScale;
		float SRho2 = SWX * SWX + SWY * SWY;
		float InvSRho = (SRho2 > 0.0f) ? rsqrt(SRho2) : 0.0f;
		float RhoW = SRho2 * InvSRho * FP_Pow2Denormalizer(MaxXY);
		float CT, ST, CP, SP;
		FP_ComplexPowInt(W.z * InvRW, RhoW * InvRW, PowerInt, CT, ST);
		FP_ComplexPowInt((SRho2 > 0.0f) ? SWX * InvSRho : 1.0f, SWY * InvSRho, PowerInt, CP, SP);
		float RWPowM1 = 1.0f;
		float Dummy = 0.0f;
		if (PowerInt > 1)
		{
			FP_ComplexPowInt(RW, 0.0f, PowerInt - 1, RWPowM1, Dummy);
		}
		OutRWPowM1 = RWPowM1;
		float RWPow = RWPowM1 * RW;
		return RWPow * float3(ST * CP, ST * SP, CT);
	}

	float Rho = sqrt(W.x * W.x + W.y * W.y);
	float Theta = FP_Atan2(Rho, W.z);
	float Phi = FP_Atan2(W.y, W.x);
	float RWPow = (RW > 0.0f) ? exp2(Power * log2(RW)) : 0.0f;
	OutRWPowM1 = RWPow * InvRW;
	float ST, CT, SP, CP;
	FP_SinCos(Power * Theta, ST, CT);
	FP_SinCos(Power * Phi, SP, CP);
	return RWPow * float3(ST * CP, ST * SP, CT);
}

// g_p(Z~ + D) - g_p(Z~) for the reference point Ref, with W = Z~ + D, RW = |W|, InvRW = 1/|W|.
// PowerInt is FP_IntegerPower(Power). Returns |W|^(p-1) in OutRWPowM1 (for the running derivative).
float3 FP_PerturbedPowerDelta(FPOrbitPoint Ref, float3 D, float3 W, float RW, float InvRW, float Power, int PowerInt, out float OutRWPowM1)
{
	// The reference is negligible next to the full point (after a rebase Ref = 0): evaluate directly.
	// Here |g(W)| dominates |g(Z~)|, so the plain difference has no cancellation.
	if (Ref.R <= 0.5f * RW)
	{
		float3 GW = FP_MandelbulbPower(W, RW, InvRW, Power, PowerInt, OutRWPowM1);
		float3 GRef = Ref.RPow * float3(Ref.SinPT * Ref.CosPP, Ref.SinPT * Ref.SinPP, Ref.CosPT);
		return GW - GRef;
	}

	float ZZ = Ref.Z.z;

	// Radial factor u = (r/R)^p - 1 with s = dr/R, dr computed without cancellation (s >= -1/2 here).
	float S = (2.0f * dot(Ref.Z, D) + dot(D, D)) / (RW + Ref.R) * Ref.InvR;
	float U;
	float OnePlusU;
	if (PowerInt > 0)
	{
		// (1+s)^p - 1 by binary powering on A = (1+s)^k - 1, B = (1+s)^k:
		//   k -> 2k:   A' = A (A + 2),     B' = B^2
		//   k -> k+1:  A' = A (1+s) + s,   B' = B (1+s)
		// All terms share the sign of s (s >= -1/2), so there is no cancellation and no log/exp.
		float Base = 1.0f + S;
		float A = S;
		float B = Base;
		[loop]
		for (int Bit = firstbithigh(PowerInt) - 1; Bit >= 0; --Bit)
		{
			A = A * (A + 2.0f);
			B = B * B;
			if (((PowerInt >> Bit) & 1) != 0)
			{
				A = A * Base + S;
				B = B * Base;
			}
		}
		U = A;
		OnePlusU = B;
	}
	else
	{
		U = FP_Expm1(Power * FP_Log1p(S));
		OnePlusU = 1.0f + U;
	}

	// xy-plane quantities are rescaled by an exact power of two so that products of small components
	// (orbits passing close to the polar axis at deep zoom) never underflow.
	float MaxXY = max(max(abs(Ref.Z.x), abs(Ref.Z.y)), max(abs(W.x), abs(W.y)));
	float XYScale = FP_Pow2Normalizer(MaxXY);
	float InvXYScale = FP_Pow2Denormalizer(MaxXY);
	float SX = Ref.Z.x * XYScale;
	float SY = Ref.Z.y * XYScale;
	float SDX = D.x * XYScale;
	float SDY = D.y * XYScale;
	float SWX = W.x * XYScale;
	float SWY = W.y * XYScale;
	float SRho = Ref.Rho * XYScale;
	float SRhoW = sqrt(SWX * SWX + SWY * SWY);
	float RhoW = SRhoW * InvXYScale;

	// Azimuth difference: exact angle between (X, Y) and (wx, wy). On the axis phi_ref := 0, i.e. (1, 0).
	bool bOnAxis = Ref.Rho <= 0.0f;
	float UX = bOnAxis ? 1.0f : SX;
	float UY = bOnAxis ? 0.0f : SY;
	float CrossP = UX * SDY - UY * SDX;
	float DotP = UX * SWX + UY * SWY;

	// rho_w - rho = (rho_w^2 - rho^2) / (rho_w + rho) evaluated without cancellation.
	float SDRho = ((2.0f * SX + SDX) * SDX + (2.0f * SY + SDY) * SDY) / max(SRhoW + SRho, 1.0e-30f);
	float DRho = SDRho * InvXYScale;
	// Polar difference: angle between (Z, rho) and (wz, rho_w) in the meridian half-plane.
	float CrossT = ZZ * DRho - Ref.Rho * D.z;
	float DotT = Ref.Rho * RhoW + ZZ * W.z;

	if (PowerInt > 0)
	{
		// Trig-free: (1 - cos, sin) of dtheta and dphi from normalised cross/dot products (the meridian
		// vectors have lengths |Z~| and |W|), multiplied by p with FP_VersSinPowInt, then
		//   sin(T + dT) - sin T = cos T sin dT - sin T vers dT,  cos(T + dT) - cos T = -sin T sin dT - cos T vers dT
		float NormT = Ref.InvR * InvRW;
		float SinDT = CrossT * NormT;
		float CosDT = DotT * NormT;
		float VT, ST;
		FP_VersSinPowInt(FP_VersineFromCosSin(CosDT, SinDT), SinDT, PowerInt, VT, ST);

		float SRhoU2 = UX * UX + UY * UY;
		float NormP = (SRhoW > 0.0f) ? rsqrt(SRhoU2) / SRhoW : 0.0f;
		float SinDP = CrossP * NormP;
		float CosDP = (SRhoW > 0.0f) ? DotP * NormP : 1.0f;
		float VP, SP;
		FP_VersSinPowInt(FP_VersineFromCosSin(CosDP, SinDP), SinDP, PowerInt, VP, SP);

		float DSinT = Ref.CosPT * ST - Ref.SinPT * VT;
		float DCosT = -Ref.SinPT * ST - Ref.CosPT * VT;
		float DSinP = Ref.CosPP * SP - Ref.SinPP * VP;
		float DCosP = -Ref.SinPP * SP - Ref.CosPP * VP;
		float SinTW = Ref.SinPT + DSinT;
		float CosTW = Ref.CosPT + DCosT;
		float SinPW = Ref.SinPP + DSinP;
		float CosPW = Ref.CosPP + DCosP;
		float3 FWI = float3(SinTW * CosPW, SinTW * SinPW, CosTW);
		float3 DFI = float3(DSinT * CosPW + Ref.SinPT * DCosP, DSinT * SinPW + Ref.SinPT * DSinP, DCosT);
		OutRWPowM1 = Ref.RPow * OnePlusU * InvRW;
		return Ref.RPow * (U * FWI + DFI);
	}

	float DPhi = FP_Atan2(CrossP, DotP);
	// Non-integer powers: keep phi_ref + dphi inside (-pi, pi] like atan2 does, which reproduces the
	// formula's seam on the -x half-plane. For integer powers the result is invariant under dphi += 2pi,
	// and wrapping would turn a small dphi into ~2pi and destroy the relative accuracy of sin(p dphi / 2).
	if (PowerInt == 0)
	{
		float PhiW = Ref.Phi + DPhi;
		DPhi += (PhiW > FP_PI) ? -FP_TWO_PI : ((PhiW <= -FP_PI) ? FP_TWO_PI : 0.0f);
	}

	float DTheta = FP_Atan2(CrossT, DotT);

	// Half-angle rotations (sum-to-product).
	float SA, CA, SB, CB;
	FP_SinCos(0.5f * Power * DTheta, SA, CA);
	FP_SinCos(0.5f * Power * DPhi, SB, CB);
	float SinTMid = Ref.SinPT * CA + Ref.CosPT * SA; // sin(p theta + p dtheta / 2)
	float CosTMid = Ref.CosPT * CA - Ref.SinPT * SA;
	float SinPMid = Ref.SinPP * CB + Ref.CosPP * SB; // sin(p phi + p dphi / 2)
	float CosPMid = Ref.CosPP * CB - Ref.SinPP * SB;

	float DSinT = 2.0f * CosTMid * SA;   // sin(T') - sin(T)
	float DCosT = -2.0f * SinTMid * SA;  // cos(T') - cos(T)
	float DSinP = 2.0f * CosPMid * SB;   // sin(P') - sin(P)
	float DCosP = -2.0f * SinPMid * SB;  // cos(P') - cos(P)

	float SinTW = Ref.SinPT + DSinT;
	float CosTW = Ref.CosPT + DCosT;
	float SinPW = Ref.SinPP + DSinP;
	float CosPW = Ref.CosPP + DCosP;

	// r^p f(T', P') - R^p f(T, P) = R^p (u f(T', P') + [f(T', P') - f(T, P)])
	float3 FW = float3(SinTW * CosPW, SinTW * SinPW, CosTW);
	float3 DF = float3(DSinT * CosPW + Ref.SinPT * DCosP, DSinT * SinPW + Ref.SinPT * DSinP, DCosT);
	OutRWPowM1 = Ref.RPow * OnePlusU * InvRW;
	return Ref.RPow * (U * FW + DF);
}

// ---------------------------------------------------------------------------------------------
// Perturbed distance estimator
// ---------------------------------------------------------------------------------------------

struct FPDEResult
{
	float Distance;   // world units (0 inside)
	int Iterations;   // n at which |z_n| > Bailout, or MaxIterations
	bool bEscaped;
	int Rebases;
	int Skipped;      // iterations replaced by the linear series skip
};

// DE at c = C_ref + DC. DC is in fractal units; Scale converts world units to fractal units, the
// returned distance is in world units. The running derivative is tracked as dr * Scale so that it
// neither overflows nor underflows at deep zoom (DE_world = 0.5 r ln r / (dr * Scale)).
// ConvergenceEpsilon > 0 enables the optional early-out when consecutive estimates stop changing.
FPDEResult FP_PerturbedDE(StructuredBuffer<float4> Orbit, int OrbitLength, float3 DC, float Scale,
	float Power, int MaxIterations, float Bailout, int MinIterations, float ConvergenceEpsilon)
{
	float3 D = DC;      // d_1 = dc (z_1 = c, Z_1 = C_ref)
	int M = 1;
	float DRS = Scale;  // |dz_1/dc| * Scale
	float RW = 0.0f;
	float Bailout2 = Bailout * Bailout;
	int PowerInt = FP_IntegerPower(Power);
	bool bEscaped = false;
	bool bConverged = false;
	float PrevDE = 1.0e30f;
	int Rebases = 0;
	int N = 1;
	int Skipped = 0;

#if FP_SERIES_SKIP
	// Linear series skip: while |d| << |Z| every iteration is d <- J d + dc, so d_m = A_m dc. The CPU stores
	// A_m and the largest |dc| for which iterations 1..m-1 stay linear (non-increasing in m); jump to the
	// deepest valid m. These are exactly the iterations that grow with zoom depth.
	{
		// Conservative |dc| bound without squaring (|dc|^2 underflows float below ~1e-19).
		float DCLength = 1.7320508f * max(max(abs(DC.x), abs(DC.y)), abs(DC.z));
		int Lo = 1;
		int Hi = OrbitLength - 1;
		[loop]
		while (Lo < Hi)
		{
			int Mid = (Lo + Hi + 1) >> 1;
			if (Orbit[FP_ORBIT_STRIDE * Mid + 3].w >= DCLength)
			{
				Lo = Mid;
			}
			else
			{
				Hi = Mid - 1;
			}
		}
		if (Lo > 1)
		{
			float4 A0 = Orbit[FP_ORBIT_STRIDE * Lo + 3];
			float4 A1 = Orbit[FP_ORBIT_STRIDE * Lo + 4];
			float4 A2 = Orbit[FP_ORBIT_STRIDE * Lo + 5];
			D = float3(dot(A0.xyz, DC), dot(A1.xyz, DC), dot(A2.xyz, DC));
			DRS = A1.w * Scale;
			M = Lo;
			N = Lo;
			Skipped = Lo - 1;
		}
	}
#endif

	[loop]
	for (; N < MaxIterations; ++N)
	{
		FPOrbitPoint Ref = FP_LoadOrbitPoint(Orbit, M);
		float3 W = Ref.Z + D;
		float RW2 = dot(W, W);
		float InvRW = (RW2 > 0.0f) ? rsqrt(RW2) : 0.0f;
		RW = RW2 * InvRW;
		if (RW2 > Bailout2)
		{
			bEscaped = true;
			break;
		}
		if (ConvergenceEpsilon > 0.0f)
		{
			float CurrentDE = 0.5f * log(max(RW, 1.0e-6f)) * RW / max(DRS, 1.0e-37f);
			if (N >= MinIterations && abs(CurrentDE - PrevDE) < ConvergenceEpsilon)
			{
				bConverged = true;
				break;
			}
			PrevDE = CurrentDE;
		}
		if (RW2 < dot(D, D) || M >= OrbitLength - 1)
		{
			// Rebase onto Z_0 = 0: the full point becomes the delta.
			D = W;
			M = 0;
			Ref = FP_ZeroOrbitPoint();
			++Rebases;
		}
		float RWPowM1;
		float3 G = FP_PerturbedPowerDelta(Ref, D, W, RW, InvRW, Power, PowerInt, RWPowM1);
		DRS = Power * RWPowM1 * DRS + Scale;
		D = G + DC;
		++M;
	}

	FPDEResult Result;
	Result.Iterations = N;
	Result.bEscaped = bEscaped;
	Result.Rebases = Rebases;
	Result.Skipped = Skipped;
	Result.Distance = (bEscaped || bConverged) ? 0.5f * RW * log(max(RW, 1.0e-6f)) / max(DRS, 1.0e-37f) : 0.0f;
	return Result;
}

// Plain float DE at an absolute position (no perturbation). Used for comparison and as the shallow-zoom
// fallback when no reference orbit is available.
FPDEResult FP_DirectDE(float3 C, float Scale, float Power, int MaxIterations, float Bailout)
{
	float3 Z = C;
	float DRS = Scale;
	float RW = 0.0f;
	int PowerInt = FP_IntegerPower(Power);
	bool bEscaped = false;
	int N = 1;
	[loop]
	for (; N < MaxIterations; ++N)
	{
		float RW2 = dot(Z, Z);
		float InvRW = (RW2 > 0.0f) ? rsqrt(RW2) : 0.0f;
		RW = RW2 * InvRW;
		if (RW > Bailout)
		{
			bEscaped = true;
			break;
		}
		float RWPowM1;
		float3 G = FP_MandelbulbPower(Z, RW, InvRW, Power, PowerInt, RWPowM1);
		DRS = Power * RWPowM1 * DRS + Scale;
		Z = G + C;
	}
	FPDEResult Result;
	Result.Iterations = N;
	Result.bEscaped = bEscaped;
	Result.Rebases = 0;
	Result.Skipped = 0;
	Result.Distance = bEscaped ? 0.5f * RW * log(RW) / DRS : 0.0f;
	return Result;
}
