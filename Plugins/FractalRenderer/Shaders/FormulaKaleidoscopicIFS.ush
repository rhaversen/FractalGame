// Kaleidoscopic IFS: z_1 = c, z_{n+1} = s * SphereFold(Sort(|z_n|)) + c, dr' = |s| k dr + 1
// (CPU: FractalMath/Formulas/KaleidoscopicIFSFormula.h).

#pragma once

#include "FractalFoldTracker.ush"
#include "FractalFolds.ush"

#define FP_STATE float3
#define FP_STATE_DIM 3
#define FP_PAYLOAD_FLOAT4 3
#define FP_FORMULA_ADDS_C 1
#define FP_FORMULA_FOLDING 1

FP_STATE FP_FormulaStart(float3 Position)
{
	return Position;
}

FP_STATE FP_FormulaLoadState(StructuredBuffer<float4> Orbit, int Base)
{
	return Orbit[Base].xyz;
}

void FP_FormulaPerturbedStep(StructuredBuffer<float4> Orbit, int Base, inout FP_STATE D, FP_STATE W, float RW, float InvRW,
	float3 DC, inout float DRS, FPFormulaArgs Args)
{
	float4 P0 = Orbit[Base];     // Z~, reference fold code
	float4 P1 = Orbit[Base + 1]; // X0+X1, X0+X2, X1+X2, X0-X1
	float4 P2 = Orbit[Base + 2]; // X0-X2, X1-X2, 1/4 - |B|^2, 1 - |B|^2
	FPPairTable Pairs = FP_LoadPairTable(P1, P2);
	FPFoldTracker T = FP_FoldTrackerBegin(D);
	FP_FoldAbs(T, P0.xyz);
	FP_FoldSort(T, Pairs);
	float3 B;
	float3 Delta = FP_FoldTrackerOffset(T, Pairs, P0.xyz, P0.w, B);
	// |B|^2 = |Z|^2 only scales (relative accuracy suffices); the branch tests use the precise P2.zw.
	float K = FP_PerturbedSphereFold(B, Delta, float3(P2.z, P2.w, dot(B, B)));
	D = Args.Power * Delta + DC;
	DRS = DRS * K * abs(Args.Power) + Args.Scale;
}

void FP_FormulaDirectStep(inout FP_STATE Z, float RW, float InvRW, float3 C, inout float DRS, FPFormulaArgs Args)
{
	float3 B = FP_SortDescending(abs(Z));
	float K = FP_SphereFoldFactor(dot(B, B));
	Z = B * (K * Args.Power) + C;
	DRS = DRS * K * abs(Args.Power) + Args.Scale;
}
